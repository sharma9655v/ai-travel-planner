    "prefetch:destinations": "tsx scripts/prefetch-destinations.ts",
    "measure:generation": "tsx scripts/measure-generation.ts",
    "probe:models": "tsx scripts/probe-models.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.42.2",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^1.27.0",
    "next": "16.2.12",
    "nodemailer": "^9.0.4",
    "openai": "^7.4.0",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-leaflet": "^5.0.0",
    "react-leaflet-cluster": "^4.1.3",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
